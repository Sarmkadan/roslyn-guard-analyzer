{
  "RoslynGuardAnalyzer": {
    "ProjectPath": "./",
    "AnalysisTimeoutSeconds": 600,
    "MaxViolationsToReport": 1000,
    "LogLevel": 2,
    "OutputFormat": "text",
    "OutputFile": null,
    "GenerateReport": true,
    "ReportType": "summary",
    "FailOnViolations": true,
    "SkipCache": false,
    "MaxParallelThreads": 8,
    "RuleFilter": [],
    "ExcludePatterns": [
      "**/bin/**",
      "**/obj/**",
      "**/*.Generated.cs",
      "**/*.Designer.cs"
    ],
    "MinimumSeverity": "Low",
    "ConfigFile": null
  }
}
